{
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.jsx?$": "babel-jest"
  },
  "testMatch": ["<rootDir>/tests/unit/**/*.test.js"],
  "setupFilesAfterEnv": ["jest-location-mock"],
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "<rootDir>/tests/mocks/styleMock.js",
    "\\.(gif|ttf|eot|svg|png)$": "<rootDir>/tests/mocks/fileMock.js"
  }
}
